{
  "title": "SGLang",
  "description": "SGLang worker with a default DeepSeek-V4-Flash FP8 preset for 4x H200 serverless deployments.",
  "type": "serverless",
  "category": "language",
  "iconUrl": "https://avatars.githubusercontent.com/u/147780389?v=4",
  "config": {
    "runsOn": "GPU",
    "containerDiskInGb": 400,
    "gpuIds": "HOPPER_141",
    "gpuCount": 4,
    "allowedCudaVersions": ["12.9", "12.8", "12.7", "12.6"],
    "env": [
      {
        "key": "SGLANG_PRESET",
        "input": {
          "name": "SGLang Preset",
          "type": "string",
          "description": "Default launch preset. Use none to run generic SGLang settings.",
          "default": "deepseek-v4-flash-fp8",
          "required": false,
          "options": [
            { "value": "deepseek-v4-flash-fp8", "label": "DeepSeek V4 Flash FP8" },
            { "value": "none", "label": "None" }
          ]
        }
      },
      {
        "key": "DEEPSEEK_V4_HARDWARE",
        "input": {
          "name": "DeepSeek V4 Hardware",
          "type": "string",
          "description": "Hardware target for the DeepSeek V4 FP8 preset. This Hub template is H200-only.",
          "default": "h200",
          "required": false,
          "options": [
            { "value": "h200", "label": "H200" }
          ]
        }
      },
      {
        "key": "DEEPSEEK_V4_RECIPE",
        "input": {
          "name": "DeepSeek V4 Recipe",
          "type": "string",
          "description": "Latency/throughput recipe for the DeepSeek V4 FP8 preset.",
          "default": "balanced",
          "required": false,
          "options": [
            { "value": "balanced", "label": "Balanced" },
            { "value": "low-latency", "label": "Low Latency" },
            { "value": "max-throughput", "label": "Max Throughput" }
          ]
        }
      },
      {
        "key": "MODEL_NAME",
        "input": {
          "name": "Model",
          "type": "huggingface",
          "description": "Hugging Face model name or local path. Defaults to the DeepSeek V4 Flash FP8 weights.",
          "default": "sgl-project/DeepSeek-V4-Flash-FP8",
          "required": false
        }
      },
      {
        "key": "BASE_PATH",
        "input": {
          "name": "Persistent Cache Base Path",
          "type": "string",
          "description": "Base path for model caches. On RunPod Serverless attach a Network Volume mounted at /runpod-volume so model weights persist across worker restarts.",
          "default": "/runpod-volume",
          "required": false,
          "advanced": true
        }
      },
      {
        "key": "HF_HOME",
        "input": {
          "name": "Hugging Face Cache",
          "type": "string",
          "description": "Hugging Face cache directory. Keep this on /runpod-volume to avoid re-downloading weights on each cold start.",
          "default": "/runpod-volume/huggingface-cache/hub",
          "required": false,
          "advanced": true
        }
      },
      {
        "key": "HUGGINGFACE_HUB_CACHE",
        "input": {
          "name": "Hugging Face Hub Cache",
          "type": "string",
          "description": "Hub cache directory used by SGLang/Hugging Face downloads.",
          "default": "/runpod-volume/huggingface-cache/hub",
          "required": false,
          "advanced": true
        }
      },
      {
        "key": "SGLANG_DSV4_FP4_EXPERTS",
        "input": {
          "name": "DeepSeek V4 FP4 Experts",
          "type": "string",
          "description": "H200 FP8 preset environment flag. Keep 0 for sgl-project DeepSeek V4 FP8 weights.",
          "default": "0",
          "required": false,
          "advanced": true
        }
      },
      {
        "key": "SGLANG_DEEPEP_NUM_MAX_DISPATCH_TOKENS_PER_RANK",
        "input": {
          "name": "DeepEP Dispatch Tokens per Rank",
          "type": "number",
          "description": "DeepEP dispatch buffer cap. Balanced H200 FP8 uses 256.",
          "default": 256,
          "required": false,
          "advanced": true
        }
      },
      {
        "key": "TOOL_CALL_PARSER",
        "input": {
          "name": "Tool Call Parser",
          "type": "string",
          "description": "Defines the parser used to interpret tool call responses",
          "default": "deepseekv4",
          "required": false,
          "advanced": true,
          "options": [
            { "value": "llama3", "label": "llama3" },
            { "value": "llama4", "label": "llama4" },
            { "value": "mistral", "label": "mistral" },
            { "value": "qwen25", "label": "qwen25" },
            { "value": "deepseekv3", "label": "deepseekv3" },
            { "value": "deepseekv4", "label": "deepseekv4" }
          ]
        }
      },
      {
        "key": "REASONING_PARSER",
        "input": {
          "name": "Reasoning Parser",
          "type": "string",
          "description": "Defines the parser used to interpret reasoning traces",
          "default": "deepseek-v4",
          "required": false,
          "advanced": true,
          "options": [
            { "value": "llama3", "label": "llama3" },
            { "value": "llama4", "label": "llama4" },
            { "value": "mistral", "label": "mistral" },
            { "value": "qwen25", "label": "qwen25" },
            { "value": "deepseekv3", "label": "deepseekv3" },
            { "value": "deepseek-v4", "label": "deepseek-v4" }
          ]
        }
      },
      {
        "key": "TOKENIZER_PATH",
        "input": {
          "name": "Tokenizer Path",
          "type": "string",
          "description": "Path of the tokenizer",
          "default": "",
          "required": false,
          "advanced": true
        }
      },
      {
        "key": "TOKENIZER_MODE",
        "input": {
          "name": "Tokenizer Mode",
          "type": "string",
          "description": "Tokenizer mode",
          "default": "auto",
          "required": false,
          "options": [
            { "value": "auto", "label": "auto" },
            { "value": "slow", "label": "slow" }
          ],
          "advanced": true
        }
      },
      {
        "key": "LOAD_FORMAT",
        "input": {
          "name": "Load Format",
          "type": "string",
          "description": "Format of model weights to load",
          "default": "auto",
          "required": false,
          "options": [
            { "value": "auto", "label": "auto" },
            { "value": "pt", "label": "pt" },
            { "value": "safetensors", "label": "safetensors" },
            { "value": "npcache", "label": "npcache" },
            { "value": "dummy", "label": "dummy" }
          ],
          "advanced": true
        }
      },
      {
        "key": "DTYPE",
        "input": {
          "name": "Data Type",
          "type": "string",
          "description": "Data type for weights and activations",
          "default": "auto",
          "required": false,
          "options": [
            { "value": "auto", "label": "auto" },
            { "value": "half", "label": "half" },
            { "value": "float16", "label": "float16" },
            { "value": "bfloat16", "label": "bfloat16" },
            { "value": "float", "label": "float" },
            { "value": "float32", "label": "float32" }
          ],
          "advanced": true
        }
      },
      {
        "key": "CONTEXT_LENGTH",
        "input": {
          "name": "Context Length",
          "type": "number",
          "description": "Model's maximum context length",
          "default": 400000,
          "required": false,
          "advanced": true
        }
      },
      {
        "key": "QUANTIZATION",
        "input": {
          "name": "Quantization",
          "type": "string",
          "description": "Quantization method",
          "default": "",
          "required": false,
          "options": [
            { "value": "awq", "label": "AWQ" },
            { "value": "fp8", "label": "FP8" },
            { "value": "gptq", "label": "GPTQ" },
            { "value": "marlin", "label": "Marlin" },
            { "value": "gptq_marlin", "label": "GPTQ Marlin" },
            { "value": "awq_marlin", "label": "AWQ Marlin" },
            { "value": "squeezellm", "label": "SqueezeLLM" },
            { "value": "bitsandbytes", "label": "BitsAndBytes" }
          ],
          "advanced": true
        }
      },
      {
        "key": "SERVED_MODEL_NAME",
        "input": {
          "name": "Served Model Name",
          "type": "string",
          "description": "Override model name in API",
          "default": "deepseek-ai/DeepSeek-V4-Flash",
          "required": false,
          "advanced": true
        }
      },
      {
        "key": "CHAT_TEMPLATE",
        "input": {
          "name": "Chat Template",
          "type": "string",
          "description": "Chat template name or path",
          "default": "",
          "required": false,
          "advanced": true
        }
      },
      {
        "key": "MEM_FRACTION_STATIC",
        "input": {
          "name": "Memory Fraction Static",
          "type": "number",
          "description": "Fraction of memory for static allocation",
          "default": "",
          "required": false,
          "advanced": true
        }
      },
      {
        "key": "MAX_RUNNING_REQUESTS",
        "input": {
          "name": "Max Running Requests",
          "type": "number",
          "description": "Maximum number of running requests",
          "default": "",
          "required": false,
          "advanced": true
        }
      },
      {
        "key": "MAX_TOTAL_TOKENS",
        "input": {
          "name": "Max Total Tokens",
          "type": "number",
          "description": "Maximum tokens in memory pool",
          "default": "",
          "required": false,
          "advanced": true
        }
      },
      {
        "key": "CHUNKED_PREFILL_SIZE",
        "input": {
          "name": "Chunked Prefill Size",
          "type": "number",
          "description": "Max tokens in chunk for chunked prefill",
          "default": "",
          "required": false,
          "advanced": true
        }
      },
      {
        "key": "MAX_PREFILL_TOKENS",
        "input": {
          "name": "Max Prefill Tokens",
          "type": "number",
          "description": "Max tokens in prefill batch",
          "default": "",
          "required": false,
          "advanced": true
        }
      },
      {
        "key": "SCHEDULE_POLICY",
        "input": {
          "name": "Schedule Policy",
          "type": "string",
          "description": "Request scheduling policy",
          "default": "",
          "required": false,
          "options": [
            { "value": "lpm", "label": "LPM" },
            { "value": "random", "label": "Random" },
            { "value": "fcfs", "label": "FCFS" },
            { "value": "dfs-weight", "label": "DFS Weight" }
          ],
          "advanced": true
        }
      },
      {
        "key": "SCHEDULE_CONSERVATIVENESS",
        "input": {
          "name": "Schedule Conservativeness",
          "type": "number",
          "description": "Conservativeness of schedule policy",
          "default": "",
          "required": false,
          "advanced": true
        }
      },
      {
        "key": "TENSOR_PARALLEL_SIZE",
        "input": {
          "name": "Tensor Parallel Size",
          "type": "number",
          "description": "Tensor parallelism size",
          "default": "",
          "required": false,
          "advanced": true
        }
      },
      {
        "key": "STREAM_INTERVAL",
        "input": {
          "name": "Stream Interval",
          "type": "number",
          "description": "Streaming interval in token length",
          "default": "",
          "required": false,
          "advanced": true
        }
      },
      {
        "key": "RANDOM_SEED",
        "input": {
          "name": "Random Seed",
          "type": "number",
          "description": "Random seed",
          "default": "",
          "required": false,
          "advanced": true
        }
      },
      {
        "key": "LOG_LEVEL",
        "input": {
          "name": "Log Level",
          "type": "string",
          "description": "Logging level for all loggers",
          "default": "",
          "required": false,
          "advanced": true
        }
      },
      {
        "key": "LOG_LEVEL_HTTP",
        "input": {
          "name": "HTTP Log Level",
          "type": "string",
          "description": "Logging level for HTTP server",
          "default": "",
          "required": false,
          "advanced": true
        }
      },
      {
        "key": "API_KEY",
        "input": {
          "name": "API Key",
          "type": "string",
          "description": "API key for the server",
          "default": "",
          "required": false,
          "advanced": true
        }
      },
      {
        "key": "FILE_STORAGE_PATH",
        "input": {
          "name": "File Storage Path",
          "type": "string",
          "description": "Path of file storage in backend",
          "default": "",
          "required": false,
          "advanced": true
        }
      },
      {
        "key": "DATA_PARALLEL_SIZE",
        "input": {
          "name": "Data Parallel Size",
          "type": "number",
          "description": "Data parallelism size",
          "default": "",
          "required": false,
          "advanced": true
        }
      },
      {
        "key": "MOE_A2A_BACKEND",
        "input": {
          "name": "MoE A2A Backend",
          "type": "string",
          "description": "MoE all-to-all backend. The DeepSeek V4 FP8 preset defaults to deepep.",
          "default": "",
          "required": false,
          "options": [
            { "value": "deepep", "label": "DeepEP" },
            { "value": "none", "label": "None" }
          ],
          "advanced": true
        }
      },
      {
        "key": "DEEPEP_CONFIG",
        "input": {
          "name": "DeepEP Config",
          "type": "string",
          "description": "JSON passed to --deepep-config.",
          "default": "",
          "required": false,
          "advanced": true
        }
      },
      {
        "key": "CUDA_GRAPH_MAX_BS",
        "input": {
          "name": "CUDA Graph Max Batch",
          "type": "number",
          "description": "Maximum CUDA graph batch size.",
          "default": "",
          "required": false,
          "advanced": true
        }
      },
      {
        "key": "SPECULATIVE_ALGO",
        "input": {
          "name": "Speculative Algorithm",
          "type": "string",
          "description": "Speculative decoding algorithm.",
          "default": "",
          "required": false,
          "options": [
            { "value": "EAGLE", "label": "EAGLE" },
            { "value": "none", "label": "None" }
          ],
          "advanced": true
        }
      },
      {
        "key": "SPECULATIVE_NUM_STEPS",
        "input": {
          "name": "Speculative Steps",
          "type": "number",
          "description": "Number of speculative decoding steps.",
          "default": "",
          "required": false,
          "advanced": true
        }
      },
      {
        "key": "SPECULATIVE_EAGLE_TOPK",
        "input": {
          "name": "EAGLE Top-K",
          "type": "number",
          "description": "Top-k for EAGLE speculative decoding.",
          "default": "",
          "required": false,
          "advanced": true
        }
      },
      {
        "key": "SPECULATIVE_NUM_DRAFT_TOKENS",
        "input": {
          "name": "Draft Tokens",
          "type": "number",
          "description": "Number of speculative draft tokens.",
          "default": "",
          "required": false,
          "advanced": true
        }
      },
      {
        "key": "LOAD_BALANCE_METHOD",
        "input": {
          "name": "Load Balance Method",
          "type": "string",
          "description": "Load balancing strategy",
          "default": "",
          "required": false,
          "options": [
            { "value": "round_robin", "label": "Round Robin" },
            { "value": "shortest_queue", "label": "Shortest Queue" }
          ],
          "advanced": true
        }
      },
      {
        "key": "SKIP_TOKENIZER_INIT",
        "input": {
          "name": "Skip Tokenizer Init",
          "type": "boolean",
          "description": "Skip tokenizer init",
          "default": false,
          "required": false,
          "advanced": true
        }
      },
      {
        "key": "TRUST_REMOTE_CODE",
        "input": {
          "name": "Trust Remote Code",
          "type": "boolean",
          "description": "Allow custom models from Hub",
          "default": true,
          "required": false,
          "advanced": true
        }
      },
      {
        "key": "LOG_REQUESTS",
        "input": {
          "name": "Log Requests",
          "type": "boolean",
          "description": "Log inputs and outputs of requests",
          "default": false,
          "required": false,
          "advanced": true
        }
      },
      {
        "key": "SHOW_TIME_COST",
        "input": {
          "name": "Show Time Cost",
          "type": "boolean",
          "description": "Show time cost of custom marks",
          "default": false,
          "required": false,
          "advanced": true
        }
      },
      {
        "key": "DISABLE_RADIX_CACHE",
        "input": {
          "name": "Disable Radix Cache",
          "type": "boolean",
          "description": "Disable RadixAttention for prefix caching",
          "default": false,
          "required": false,
          "advanced": true
        }
      },
      {
        "key": "DISABLE_CUDA_GRAPH",
        "input": {
          "name": "Disable CUDA Graph",
          "type": "boolean",
          "description": "Disable cuda graph",
          "default": false,
          "required": false,
          "advanced": true
        }
      },
      {
        "key": "DISABLE_OUTLINES_DISK_CACHE",
        "input": {
          "name": "Disable Outlines Disk Cache",
          "type": "boolean",
          "description": "Disable disk cache of outlines",
          "default": false,
          "required": false,
          "advanced": true
        }
      },
      {
        "key": "ENABLE_TORCH_COMPILE",
        "input": {
          "name": "Enable Torch Compile",
          "type": "boolean",
          "description": "Optimize model with torch.compile",
          "default": false,
          "required": false,
          "advanced": true
        }
      },
      {
        "key": "ENABLE_P2P_CHECK",
        "input": {
          "name": "Enable P2P Check",
          "type": "boolean",
          "description": "Enable P2P check for GPU access",
          "default": false,
          "required": false,
          "advanced": true
        }
      },
      {
        "key": "ENABLE_FLASHINFER_MLA",
        "input": {
          "name": "Enable FlashInfer MLA",
          "type": "boolean",
          "description": "Enable FlashInfer Multi-head Latent Attention",
          "default": false,
          "required": false,
          "advanced": true
        }
      },
      {
        "key": "ENABLE_DP_ATTENTION",
        "input": {
          "name": "Enable DP Attention",
          "type": "boolean",
          "description": "Enable data-parallel attention.",
          "default": true,
          "required": false,
          "advanced": true
        }
      },
      {
        "key": "TRITON_ATTENTION_REDUCE_IN_FP32",
        "input": {
          "name": "Triton Attention Reduce in FP32",
          "type": "boolean",
          "description": "Cast Triton attention results to fp32",
          "default": false,
          "required": false,
          "advanced": true
        }
      }
    ]
  }
}
