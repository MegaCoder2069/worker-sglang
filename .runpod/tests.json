{
  "tests": [
    {
      "name": "deepseek_v4_flash_fp8_h200_chat",
      "input": {
        "model": "deepseek-ai/DeepSeek-V4-Flash",
        "messages": [
          { "role": "user", "content": "Reply with exactly: H200 DeepSeek V4 Flash FP8 ready" }
        ],
        "max_tokens": 32,
        "temperature": 0
      },
      "timeout": 1200000
    }
  ],
  "config": {
    "gpuTypeId": "HOPPER_141",
    "gpuCount": 4,
    "env": [
      {
        "key": "SGLANG_PRESET",
        "value": "deepseek-v4-flash-fp8"
      },
      {
        "key": "DEEPSEEK_V4_HARDWARE",
        "value": "h200"
      },
      {
        "key": "DEEPSEEK_V4_RECIPE",
        "value": "balanced"
      },
      {
        "key": "MODEL_NAME",
        "value": "sgl-project/DeepSeek-V4-Flash-FP8"
      },
      {
        "key": "SERVED_MODEL_NAME",
        "value": "deepseek-ai/DeepSeek-V4-Flash"
      },
      {
        "key": "BASE_PATH",
        "value": "/runpod-volume"
      },
      {
        "key": "HF_HOME",
        "value": "/runpod-volume/huggingface-cache/hub"
      },
      {
        "key": "HUGGINGFACE_HUB_CACHE",
        "value": "/runpod-volume/huggingface-cache/hub"
      },
      {
        "key": "CONTEXT_LENGTH",
        "value": "400000"
      },
      {
        "key": "TOOL_CALL_PARSER",
        "value": "deepseekv4"
      },
      {
        "key": "REASONING_PARSER",
        "value": "deepseek-v4"
      },
      {
        "key": "TP",
        "value": "4"
      },
      {
        "key": "DP",
        "value": "4"
      },
      {
        "key": "ENABLE_DP_ATTENTION",
        "value": "true"
      },
      {
        "key": "MOE_A2A_BACKEND",
        "value": "deepep"
      },
      {
        "key": "SPECULATIVE_ALGO",
        "value": "EAGLE"
      },
      {
        "key": "SPECULATIVE_NUM_STEPS",
        "value": "1"
      },
      {
        "key": "SPECULATIVE_EAGLE_TOPK",
        "value": "1"
      },
      {
        "key": "SPECULATIVE_NUM_DRAFT_TOKENS",
        "value": "2"
      },
      {
        "key": "CUDA_GRAPH_MAX_BS",
        "value": "128"
      },
      {
        "key": "MAX_RUNNING_REQUESTS",
        "value": "128"
      },
      {
        "key": "DEEPEP_CONFIG",
        "value": "{\"normal_dispatch\":{\"num_sms\":96},\"normal_combine\":{\"num_sms\":96}}"
      },
      {
        "key": "SGLANG_DSV4_FP4_EXPERTS",
        "value": "0"
      },
      {
        "key": "SGLANG_DEEPEP_NUM_MAX_DISPATCH_TOKENS_PER_RANK",
        "value": "256"
      },
      {
        "key": "TRUST_REMOTE_CODE",
        "value": "true"
      }
    ],
    "allowedCudaVersions": ["12.9", "12.8", "12.7", "12.6"]
  }
}
